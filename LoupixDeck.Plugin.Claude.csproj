<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoupixDeck.Plugin.Claude</AssemblyName>
    <RootNamespace>LoupixDeck.Plugin.Claude</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Authors>Craig Lawson</Authors>
    <Description>Day-to-day Claude from the deck: open Claude, Quick Entry, Settings, a usage gauge and a key that lights when a Claude Code session is waiting for you.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides the SDK assembly at runtime; never ship it next to the plugin. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.28.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="icon.png" LogicalName="LoupixDeck.Plugin.Claude.icon.png" />
  </ItemGroup>

  <!--
    Post-build copy into the LoupixDeck plugin folder so every build is picked up by the host.
    Pass -p:LoupixDebugHost=true to target a Debug build of the host, which reads
    ~/.config/LoupixDeck/debug/plugins instead of ~/.config/LoupixDeck/plugins.
  -->
  <PropertyGroup>
    <LoupixDebugSuffix Condition="'$(LoupixDebugHost)' == 'true'">/debug</LoupixDebugSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <PluginInstallDir>$(AppData)\LoupixDeck\plugins\claude</PluginInstallDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <PluginInstallDir>$(HOME)/.config/LoupixDeck$(LoupixDebugSuffix)/plugins/claude</PluginInstallDir>
  </PropertyGroup>

  <Target Name="CopyToPluginFolder" AfterTargets="Build" Condition="'$(LoupixSkipInstall)' != 'true'">
    <MakeDir Directories="$(PluginInstallDir)" />
    <ItemGroup>
      <PluginFiles Include="$(OutDir)**\*.*"
                   Exclude="$(OutDir)LoupixDeck.PluginSdk.*;$(OutDir)*.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)"
          DestinationFolder="$(PluginInstallDir)/%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/plugin.json"
          DestinationFolder="$(PluginInstallDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Claude plugin copied to $(PluginInstallDir)" />
  </Target>

</Project>
